# ═══════════════════════════════════════════════════════════
# Telegram Bot Configuration
# ═══════════════════════════════════════════════════════════
# Obtenha o token do @BotFather no Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# IDs dos chats que receberão notificações
# Formato: chat_id:1 (ativo) ou chat_id:0 (desativado)
# Separe múltiplos IDs com | (pipe)
# Exemplo: 123456789:1|987654321:1|555555555:0
TELEGRAM_CHAT_IDS=123456789:1

# Envia um ping ao iniciar para validar IDs (0 ou 1)
TELEGRAM_STARTUP_PING=0

# ═══════════════════════════════════════════════════════════
# Camera Configuration
# ═══════════════════════════════════════════════════════════
# URLs RTSP das câmeras (separe múltiplas URLs com |)
# Formato: rtsp://usuario:senha@ip:porta/caminho
RTSP_URLS=rtsp://user:password@192.168.1.100:554/cam/realmonitor?channel=1&subtype=0

# Nomes das câmeras (opcional, separe com |)
# Deve ter o mesmo número de entradas que RTSP_URLS
CAMERA_NAMES=Câmera 1

# ═══════════════════════════════════════════════════════════
# Detection Settings
# ═══════════════════════════════════════════════════════════
# Caminho do modelo YOLO (yolov8n.pt, yolov8s.pt, yolov8m.pt, etc)
DETECTION_MODEL=models/yolo26n.pt

# Confiança mínima para detecção (0.0 a 1.0)
# Valores mais baixos = mais detecções (mais falsos positivos)
# Valores mais altos = menos detecções (pode perder objetos reais)
# Recomendado: 0.35 (balanceado)
CONFIDENCE_THRESHOLD=0.35

# NMS IoU threshold (maior = menos supressão entre boxes)
NMS_IOU_THRESHOLD=0.65

# Redimensionar frame para detecção (0 = tamanho original)
# Valores menores = detecção mais rápida, mas menos precisa
# Recomendado: 480 (bom equilíbrio)
DETECTION_RESIZE=480

# ═══════════════════════════════════════════════════════════
# Tracking (Multi-objeto)
# ═══════════════════════════════════════════════════════════
# IoU mínimo para associar detecção a um track existente
TRACK_IOU_THRESHOLD=0.30

# Quantos frames um track pode ficar sem match antes de expirar
TRACK_MAX_MISSES=5

# Mínimo de hits para considerar um track como novo (1 = primeiro frame)
TRACK_MIN_HITS=1

# ═══════════════════════════════════════════════════════════
# Notification Settings
# ═══════════════════════════════════════════════════════════
# Tempo mínimo entre envios (segundos) - evita spam
SEND_COOLDOWN=1

# Largura máxima da imagem enviada ao Telegram (0 = original)
# Imagens menores = envio mais rápido
SEND_MAX_WIDTH=960

# Timeout para envio ao Telegram (segundos)
SEND_TIMEOUT=8

# Requisitos mínimos para envio (reduz frequência)
SEND_MIN_STREAK=1
SEND_MIN_MOVEMENT_SCORE=0
SEND_MIN_MOVED_OBJECTS=1

# ═══════════════════════════════════════════════════════════
# Advanced (Optional)
# ═══════════════════════════════════════════════════════════
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Logging
LOG_LEVEL=INFO
LOG_ROTATE_MAX_MB=10
LOG_ROTATE_BACKUPS=5
LOG_THROTTLE_SECONDS=30

# ═══════════════════════════════════════════════════════════
# 🚀 MELHORIAS AVANÇADAS - Sistema de Detecção Inteligente
# ═══════════════════════════════════════════════════════════

# ---------------------------------------------------------
# FILTROS AVANÇADOS DE DETECÇÃO ✨
# ---------------------------------------------------------
# Área mínima em pixels² para validar detecção (largura x altura)
# Exemplo: 400 = 20x20 pixels mínimo
# Reduz falsos positivos de ruídos e artefatos pequenos
MIN_DETECTION_AREA=400

# Aspect ratio válido (largura/altura)
# Elimina detecções com proporções geometricamente inválidas
MIN_ASPECT_RATIO=0.2    # Mínimo (ex: objeto muito fino)
MAX_ASPECT_RATIO=5.0    # Máximo (ex: objeto muito largo)

# Suavização temporal: número de frames consecutivos para confirmar
# Reduz detecções intermitentes e aumenta estabilidade
# Valor 3 = objeto deve aparecer em 2 de 3 frames para ser válido
TEMPORAL_SMOOTHING_FRAMES=3

# ---------------------------------------------------------
# SISTEMA DE SCORING INTELIGENTE 🎯
# ---------------------------------------------------------
# Score ponderado (0-100) que considera múltiplos fatores
# Os 4 pesos abaixo devem somar ~1.0 para melhor resultado

# Peso da confiança média das detecções (0.0-1.0)
SCORING_CONFIDENCE_WEIGHT=0.3

# Peso do movimento detectado (0.0-1.0)
SCORING_MOVEMENT_WEIGHT=0.3

# Peso de objetos novos na cena (0.0-1.0)
SCORING_NOVELTY_WEIGHT=0.2

# Peso de objetos que persistem ao longo do tempo (0.0-1.0)
SCORING_PERSISTENCE_WEIGHT=0.2

# Score mínimo para enviar frame (0-100)
# Valores mais altos = menos envios, mas mais confiáveis
# Valores mais baixos = mais envios, pode incluir falsos positivos
MIN_SEND_SCORE=50.0

# ---------------------------------------------------------
# DETECÇÃO DE EVENTOS SIGNIFICATIVOS 🚨
# ---------------------------------------------------------
# Ativa detecção automática de eventos importantes (0=não, 1=sim)
# Eventos forçam envio imediato, ignorando cooldown e score
ENABLE_EVENT_DETECTION=1

# Número mínimo de objetos para evento "multi-objeto"
MULTI_OBJECT_THRESHOLD=3

# Movimento em pixels para considerar "movimento rápido"
RAPID_MOVEMENT_THRESHOLD=150

# ---------------------------------------------------------
# SISTEMA ANTI-REPETIÇÃO MELHORADO 🛡️
# ---------------------------------------------------------
# Ativa sistema de detecção de mudança de cena (0=não, 1=sim)
ENABLE_SCENE_DETECTION=1

# Diferença mínima de hash perceptual (0-100%)
# Valores menores = mais sensível a mudanças
SCENE_HASH_THRESHOLD=15

# Mudança mínima na composição da cena (0.0-1.0)
# Usa índice de Jaccard para comparar posições dos objetos
SCENE_CHANGE_THRESHOLD=0.25

# ---------------------------------------------------------
# AGREGAÇÃO TEMPORAL 📊 (Preparado para futuro)
# ---------------------------------------------------------
# Janela de agregação em segundos
FRAME_AGGREGATION_WINDOW=2.0

# Máximo de detecções para agregar em um único envio
MAX_AGGREGATED_DETECTIONS=5

# ---------------------------------------------------------
# SISTEMA DE PRIORIZAÇÃO POR CLASSE
# ---------------------------------------------------------
# Cooldown dinâmico por prioridade (segundos)
COOLDOWN_HIGH_PRIORITY=2      # Pessoas, veículos
COOLDOWN_MEDIUM_PRIORITY=10   # Animais
COOLDOWN_LOW_PRIORITY=30      # Objetos comuns

# Confiança mínima por prioridade (0.0-1.0)
MIN_CONFIDENCE_HIGH=0.40      # 40% para alta prioridade
MIN_CONFIDENCE_MEDIUM=0.50    # 50% para média prioridade
MIN_CONFIDENCE_LOW=0.70       # 70% para baixa prioridade

# Movimento mínimo por prioridade (pixels)
MIN_MOVEMENT_HIGH=20          # 20px para alta prioridade
MIN_MOVEMENT_MEDIUM=40        # 40px para média prioridade
MIN_MOVEMENT_LOW=80           # 80px para baixa prioridade

# ═══════════════════════════════════════════════════════════
# 🎛️ PERFIS DE CONFIGURAÇÃO RECOMENDADOS
# ═══════════════════════════════════════════════════════════
# Escolha um perfil comentando/descomentando os valores:

# PERFIL 1: Alta Sensibilidade (Máximo de detecções)
# Uso: Segurança crítica, monitoramento intensivo
# MIN_DETECTION_AREA=200
# MIN_SEND_SCORE=30.0
# TEMPORAL_SMOOTHING_FRAMES=2
# SCENE_HASH_THRESHOLD=10
# MULTI_OBJECT_THRESHOLD=2

# PERFIL 2: Balanceado (Padrão - valores definidos acima)
# Uso: Uso geral, bom equilíbrio entre sensibilidade e precisão
# MIN_DETECTION_AREA=400
# MIN_SEND_SCORE=50.0
# TEMPORAL_SMOOTHING_FRAMES=3
# SCENE_HASH_THRESHOLD=15
# MULTI_OBJECT_THRESHOLD=3

# PERFIL 3: Alta Precisão (Mínimo de falsos positivos)
# Uso: Reduzir notificações, priorizar qualidade sobre quantidade
# MIN_DETECTION_AREA=800
# MIN_SEND_SCORE=70.0
# TEMPORAL_SMOOTHING_FRAMES=5
# SCENE_HASH_THRESHOLD=20
# MULTI_OBJECT_THRESHOLD=4

