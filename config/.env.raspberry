# ═══════════════════════════════════════════════════════════
# Configuração OTIMIZADA para Raspberry Pi 4
# ═══════════════════════════════════════════════════════════
# Copie este arquivo para .env ao rodar no RPi

# Telegram
TELEGRAM_BOT_TOKEN=8255940153:AAHpsW4PMRlGuyZqo7IV5fEo2z8E75EjrWE
TELEGRAM_STARTUP_PING=1

# ═══════════════════════════════════════════════════════════
# Detection Settings - OTIMIZADO PARA ARM
# ═══════════════════════════════════════════════════════════
DETECTION_MODEL=models/yolo26n.pt
CONFIDENCE_THRESHOLD=0.20      # Aumentado um pouco
NMS_IOU_THRESHOLD=0.65
DETECTION_RESIZE=416           # REDUZIDO para ARM (era 1920!)

# Tracking (mais tolerante para FPS baixo)
TRACK_IOU_THRESHOLD=0.30
TRACK_MAX_MISSES=10            # Aumentado (FPS menor)
TRACK_MIN_HITS=2

# ═══════════════════════════════════════════════════════════
# Notification Settings - COOLDOWN MAIOR
# ═══════════════════════════════════════════════════════════
SEND_COOLDOWN=3                # Aumentado (era 1)
SEND_MAX_WIDTH=960
SEND_TIMEOUT=10

# Cooldown por prioridade (mais espaçado)
COOLDOWN_HIGH_PRIORITY=5       # Era 2
MIN_CONFIDENCE_HIGH=0.25       # Era 0.15
MIN_MOVEMENT_HIGH=15           # Era 10

# ⚠️ Configurações médias/baixas não usadas
COOLDOWN_MEDIUM_PRIORITY=15
COOLDOWN_LOW_PRIORITY=45
MIN_CONFIDENCE_MEDIUM=0.50
MIN_CONFIDENCE_LOW=0.70
MIN_MOVEMENT_MEDIUM=40
MIN_MOVEMENT_LOW=80

# ═══════════════════════════════════════════════════════════
# Sistema Anti-Repetição
# ═══════════════════════════════════════════════════════════
ENABLE_SCENE_DETECTION=1
SCENE_HASH_THRESHOLD=20        # Mais tolerante
SCENE_CHANGE_THRESHOLD=0.30    # Era 0.25

# ═══════════════════════════════════════════════════════════
# Advanced
# ═══════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════
# 💡 DICAS PARA RASPBERRY PI 4:
# ═══════════════════════════════════════════════════════════
# - Comece com 2-3 câmeras, depois aumente gradualmente
# - Use cartão SD classe 10 ou SSD via USB
# - Configure GPU memory: sudo raspi-config > 256MB
# - Monitore temperatura: vcgencmd measure_temp
# - Use case com cooler/ventilador
# - Para melhor performance: DETECTION_RESIZE=320
