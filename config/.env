# ═══════════════════════════════════════════════════════════
# 🚀 FILTROS AVANÇADOS DE DETECÇÃO - PERFIL EXTREMAMENTE SENSÍVEL
# ═══════════════════════════════════════════════════════════
# Área mínima em pixels² (20x20 = 400)
MIN_DETECTION_AREA=100          # ⬇️ REDUZIDO - detecta objetos ainda menores

# Aspect ratio válido (largura/altura)
MIN_ASPECT_RATIO=0.1            # ⬇️ REDUZIDO - mais permissivo
MAX_ASPECT_RATIO=10.0           # ⬆️ AUMENTADO - mais permissivo

# Suavização temporal: número de frames para confirmar
TEMPORAL_SMOOTHING_FRAMES=1     # ⬇️ REDUZIDO - sem suavização, envia logo

# ═══════════════════════════════════════════════════════════
# 🎯 SISTEMA DE SCORING INTELIGENTE - MUITO PERMISSIVO
# ═══════════════════════════════════════════════════════════
SCORING_CONFIDENCE_WEIGHT=0.1   # ⬇️ REDUZIDO - confiança menos importante
SCORING_MOVEMENT_WEIGHT=0.4     # ⬆️ AUMENTADO
SCORING_NOVELTY_WEIGHT=0.3      # ⬆️ AUMENTADO
SCORING_PERSISTENCE_WEIGHT=0.2

MIN_SEND_SCORE=20.0             # ⬇️ DRASTICAMENTE REDUZIDO (era 50.0!)

# ═══════════════════════════════════════════════════════════
# 🚨 DETECÇÃO DE EVENTOS SIGNIFICATIVOS
# ═══════════════════════════════════════════════════════════
ENABLE_EVENT_DETECTION=1
MULTI_OBJECT_THRESHOLD=2        # ⬇️ REDUZIDO (era 3)
RAPID_MOVEMENT_THRESHOLD=50     # ⬇️ REDUZIDO (era 150)

# ═══════════════════════════════════════════════════════════
# 🛡️ SISTEMA ANTI-REPETIÇÃO - MENOS AGRESSIVO
# ═══════════════════════════════════════════════════════════
ENABLE_SCENE_DETECTION=1
SCENE_HASH_THRESHOLD=5          # ⬇️ REDUZIDO (era 15) - mais sensível
SCENE_CHANGE_THRESHOLD=0.1      # ⬇️ REDUZIDO (era 0.25) - detecta mudanças sutis

# ═══════════════════════════════════════════════════════════
# Telegram Bot Configuration
# ═══════════════════════════════════════════════════════════

TELEGRAM_BOT_TOKEN=8255940153:AAHpsW4PMRlGuyZqo7IV5fEo2z8E75EjrWE
TELEGRAM_STARTUP_PING=1

# ═══════════════════════════════════════════════════════════
# Camera & Chat Configuration
# ═══════════════════════════════════════════════════════════
# ⚠️ Configuração movida para config/empresas.json
# Estrutura hierárquica: Empresas → Câmeras → Chat IDs
# Veja ESTRUTURA_HIERARQUICA.md para detalhes

# ═══════════════════════════════════════════════════════════
# Detection Settings (Configuração MÁXIMA - Resolução Nativa)
# ═══════════════════════════════════════════════════════════
DETECTION_MODEL=models/yolo26n.pt
CONFIDENCE_THRESHOLD=0.25      # 25% - Detecção permissiva
NMS_IOU_THRESHOLD=0.65         # NMS padrão
DETECTION_RESIZE=640           # 640px - Rápido e eficiente (alterado de 1920)
FRAME_SKIP=2                   # Processa 1 a cada 2 frames

# Tracking (Multi-objeto)
TRACK_IOU_THRESHOLD=0.30
TRACK_MAX_MISSES=5
TRACK_MIN_HITS=1

# ═══════════════════════════════════════════════════════════
# Notification Settings
# ═══════════════════════════════════════════════════════════
# Cooldown global mínimo entre envios (segundos)
SEND_COOLDOWN=2                # REDUZIDO PARA 2 SEGUNDOS
SEND_MAX_WIDTH=800
SEND_TIMEOUT=8
SEND_MIN_STREAK=1              # Envia logo (era 3)
SEND_MIN_MOVEMENT_SCORE=0      # Sem score mínimo (era 25)
SEND_MIN_MOVED_OBJECTS=1

# Prioridade de classes
COOLDOWN_HIGH_PRIORITY=2
MIN_CONFIDENCE_HIGH=0.30
MIN_MOVEMENT_HIGH=20
COOLDOWN_MEDIUM_PRIORITY=10
COOLDOWN_LOW_PRIORITY=30
MIN_CONFIDENCE_MEDIUM=0.50
MIN_CONFIDENCE_LOW=0.70
MIN_MOVEMENT_MEDIUM=40
MIN_MOVEMENT_LOW=80

# ═══════════════════════════════════════════════════════════
# Sistema Anti-Repetição (Menor Agressividade)
# ═══════════════════════════════════════════════════════════
ENABLE_SCENE_DETECTION=1
SCENE_HASH_THRESHOLD=15
SCENE_CHANGE_THRESHOLD=0.25

# ═══════════════════════════════════════════════════════════
# Advanced
# ═══════════════════════════════════════════════════════════
LOG_LEVEL=INFO
